{
  "name": "smb-automation",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve -c default",
    "build": "ng build -c production,default && node scripts/generate-seo.mjs default",
    "build:angular": "ng build -c production,default",
    "watch": "ng build --watch --configuration development,default",
    "test": "ng test",
    "check:i18n": "node scripts/check-i18n.mjs",
    "check:tenants": "node scripts/check-tenants.mjs",
    "check:contrast": "node scripts/check-contrast.mjs",
    "check": "npm run check:i18n && npm run check:tenants && npm run check:contrast"
  },
  "private": true,
  "packageManager": "npm@11.12.1",
  "dependencies": {
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/platform-server": "^21.2.0",
    "@angular/router": "^21.2.0",
    "@angular/ssr": "^21.2.27",
    "@ngx-translate/core": "^18.0.0",
    "firebase": "^13.1.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.11",
    "@angular/cli": "^21.2.11",
    "@angular/compiler-cli": "^21.2.0",
    "@types/node": "^20.17.19",
    "jsdom": "^28.0.0",
    "less": "^4.2.0",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}
