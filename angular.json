{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm"
  },
  "newProjectRoot": "projects",
  "projects": {
    "SMB-automation": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "less"
        }
      },
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "inlineStyleLanguage": "less",
            "stylePreprocessorOptions": {
              "includePaths": ["src/styles"]
            },
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              }
            ],
            "styles": ["src/styles.less", "src/tenants/default/theme.less"],
            "server": "src/main.server.ts",
            "outputMode": "static"
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "4kB",
                  "maximumError": "8kB"
                }
              ],
              "outputHashing": "all"
            },
            "default": {
              "outputPath": "dist/default",
              "fileReplacements": [
                {
                  "replace": "src/app/core/tenant/active-tenant.ts",
                  "with": "src/tenants/default/active-tenant.ts"
                }
              ],
              "assets": [
                {
                  "glob": "**/*",
                  "input": "public/i18n",
                  "output": "i18n"
                },
                {
                  "glob": "**/*",
                  "input": "public/tenants/default",
                  "output": "tenants/default"
                }
              ],
              "styles": ["src/styles.less", "src/tenants/default/theme.less"]
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": {
            "proxyConfig": "proxy.conf.json"
          },
          "configurations": {
            "production": {
              "buildTarget": "SMB-automation:build:production"
            },
            "development": {
              "buildTarget": "SMB-automation:build:development"
            },
            "default": {
              "buildTarget": "SMB-automation:build:development,default"
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular/build:unit-test"
        }
      }
    }
  }
}
